# Server only. Never prefix this key with VITE_ or put it in browser code.
MODEL_API_KEY=
# Private runtime directory; never mount it as a static directory.
R2P_DATA_DIR=.data
# Local defaults: 2 concurrent model jobs, 8 outstanding jobs, 30 mutations/minute.
R2P_MODEL_CONCURRENCY=2
R2P_MAX_JOBS=8
R2P_MUTATIONS_PER_MINUTE=30
